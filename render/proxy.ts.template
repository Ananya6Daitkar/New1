import {NextResponse,type NextRequest} from 'next/server';import {verifySession} from './render/session';
export function proxy(req:NextRequest){const path=req.nextUrl.pathname;if(path==='/'||path==='/studio'||path==='/favicon.svg'||path.startsWith('/images/')||(path==='/api/preview'&&req.method==='GET'&&!req.nextUrl.searchParams.has('id'))||path==='/api/health'||path==='/api/auth'||path==='/signin-with-chatgpt'||path.startsWith('/_next/'))return NextResponse.next();if(!verifySession(req.cookies.get('loopfit_session')?.value)){if(path.startsWith('/api/'))return NextResponse.json({error:'Sign in required.'},{status:401});const url=new URL('/signin-with-chatgpt',req.url);url.searchParams.set('return_to',path+req.nextUrl.search);return NextResponse.redirect(url)}const headers=new Headers(req.headers);for(const key of [...headers.keys()])if(key.startsWith('oai-authenticated-'))headers.delete(key);return NextResponse.next({request:{headers}})}
